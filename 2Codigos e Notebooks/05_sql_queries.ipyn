              "\n",
              "     <input type=\"file\" id=\"files-0baeba00-2603-4fcb-b828-33c7d543bc4d\" name=\"files[]\" multiple disabled\n",
              "        style=\"border:none\" />\n",
              "     <output id=\"result-0baeba00-2603-4fcb-b828-33c7d543bc4d\">\n",
              "      Upload widget is only available when the cell has been executed in the\n",
