      "source": [
        "import sqlite3\n",
        "import pandas as pd\n",
        "\n",
        "df_silver = pd.read_csv(\"dados_enriquecidos.csv\")\n",
        "\n",
        "conn = sqlite3.connect(\"pipeline.db\")\n",
        "\n",
        "\n",
        "df_silver.to_sql(\"silver_dados_enriquecidos\", conn, if_exists=\"replace\", index=False)\n",
        "\n",
        "conn.commit()\n",
        "conn.close()\n",
        "\n",
        "print(\"✅ Tabela SILVER criada com sucesso!\")\n"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "import sqlite3\n",
        "import pandas as pd\n",
        "\n",
        "\n",
        "df_jogos = pd.read_csv(\"desempenho_jogos.csv\")\n",
        "df_dev = pd.read_csv(\"analise_desenvolvedores.csv\")\n",
        "df_metricas = pd.read_csv(\"metricas_diarias.csv\")\n",
        "\n",
        "\n",
        "conn = sqlite3.connect(\"pipeline.db\")\n",
        "\n",
        "\n",
        "df_jogos.to_sql(\"desempenho_jogos\", conn, if_exists=\"replace\", index=False)\n",
        "df_dev.to_sql(\"analise_desenvolvedores\", conn, if_exists=\"replace\", index=False)\n",
        "df_metricas.to_sql(\"metricas_diarias\", conn, if_exists=\"replace\", index=False)\n",
        "\n",
        "conn.commit()\n",
        "\n",
        "print(\"✅ Banco SQLite criado e dados importados com sucesso!\")"
      ],
      "metadata": {
